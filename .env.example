# Comma-separated key pool (at least 2). key_1, key_2, ... follow this order.
LLM_API_KEYS=your-first-key,your-second-key
# Any LiteLLM model name; keys must match its provider (gemini/..., groq/..., openai/...)
LLM_MODEL=gemini/gemini-2.5-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
CACHE_ENABLED=true
CACHE_TYPE=local
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend build-time backend URL (used by docker compose)
VITE_API_URL=http://localhost:8000
